   "source": [
    import numpy as np

def is_symmetric(A):
    return np.allclose(A, A.T)

def is_upper_triangular(A):
    return np.allclose(A, np.triu(A))

def is_lower_triangular(A):
    return np.allclose(A, np.tril(A))

def is_diagonal(A):
    return np.allclose(A, np.diag(np.diag(A)))

def is_scalar(A):
    return is_diagonal(A) and np.allclose(np.diag(A), A[0, 0])
   ]
